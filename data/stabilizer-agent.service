[Unit]
Description=Stabilizer memory monitoring and policy agent
Documentation=file:/usr/share/doc/stabilizer/README.md
After=dbus.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=dbus
BusName=io.github.stabilizer.Agent
ExecStart=/usr/bin/stabilizer-agent
Restart=always
RestartSec=2s
ManagedOOMPreference=omit
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=default.target
